            {
              "type": "text",
              "id": "p8kLM",
              "name": "Title",
              "fill": "$paper",
              "content": "Next.js App Router architecture",
              "fontFamily": "Cormorant Garamond",
              "fontSize": 30,
              "fontWeight": "normal",
              "fontStyle": "italic"
            },
            {
              "type": "text",
              "id": "A9U1ij",
              "name": "Tree",
              "fill": "$paper-dim",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "src/\n├─ app/\n│  ├─ layout.tsx        fonts, metadata, providers\n│  ├─ page.tsx          composes sections\n│  └─ globals.css       Tailwind v4 @theme tokens\n├─ components/\n│  ├─ layout/           Navbar, MobileMenu, Footer\n│  ├─ sections/         Hero, About, Menu, Gallery, Contact\n│  ├─ menu-book/        MenuBook, BookPage, BookCover,\n│  │                    PageFlip, ChapterTabs, BookControls\n│  ├─ ui/               Button, SectionLabel, Input,\n│  │                    Stepper, Chip, IconButton\n│  └─ motion/           Reveal, SplitText, Parallax,\n│                       Marquee, ClipReveal\n├─ hooks/              useScrollDirection, usePageFlip,\n│                       useMediaQuery, useReducedMotion\n├─ data/               menu.ts, gallery.ts, site.ts\n├─ lib/                animations.ts (variants, easings),\n│                       cn.ts\n└─ types/              menu.ts, gallery.ts, nav.ts\npublic/images/          optimized photos + cutouts",
              "lineHeight": 1.6,
              "fontFamily": "JetBrains Mono",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "TfHG6",
              "name": "Stack",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Next.js 15 · TypeScript strict · Tailwind CSS v4 · motion (Framer Motion) · lenis · next/image (AVIF/WebP) · next/font · lucide-react — no page-flip library: custom 3D flip built on Motion.",
              "lineHeight": 1.6,
              "fontFamily": "Manrope",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        }
